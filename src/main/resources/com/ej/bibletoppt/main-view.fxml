<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.web.WebView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.text.Text?>
<?import javafx.scene.text.TextFlow?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.ej.bibletoppt.controller.BibleToPPTController"
            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #F8F9FA, #FFFFFF);">

    <!-- Left Panel - Bible Verse Input & History -->
    <left>
        <VBox spacing="15.0" prefWidth="320" style="-fx-background-color: #F8F9FA; -fx-padding: 20;">
            <Label text="BibleToPPT" style="-fx-font-weight: bold; -fx-font-size: 24; -fx-text-fill: #4361EE;"/>
            <Separator style="-fx-background-color: #E9ECEF;"/>

            <!-- Settings Panel -->
            <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 15; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                <Label text="설정" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #212529;"/>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="슬라이드 크기:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                    <ComboBox fx:id="sizeComboBox" promptText="크기 선택" 
                              style="-fx-background-color: #F8F9FA; -fx-border-color: #CED4DA; -fx-border-radius: 4;"/>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="글꼴:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                    <ComboBox fx:id="fontComboBox" promptText="글꼴 선택" 
                              style="-fx-background-color: #F8F9FA; -fx-border-color: #CED4DA; -fx-border-radius: 4;"/>
                </HBox>

                <HBox spacing="10.0" alignment="CENTER_LEFT">
                    <Label text="본문 글자 크기:" style="-fx-font-weight: bold; -fx-text-fill: #495057;"/>
                    <ComboBox fx:id="fontSizeComboBox" promptText="크기 선택" 
                              style="-fx-background-color: #F8F9FA; -fx-border-color: #CED4DA; -fx-border-radius: 4;"/>
                </HBox>

                <CheckBox fx:id="titleSlideCheckBox" text="제목 슬라이드 추가"
                          style="-fx-text-fill: #495057;"/>
            </VBox>

            <!-- Bible Verse Input -->
            <Label text="성경구절 입력" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #212529;"/>
            <VBox>
                <TextField fx:id="inputField" promptText="성경구절 입력 (예: 창 1:1)"
                           style="-fx-background-color: white; -fx-border-color: #CED4DA; -fx-border-radius: 4; -fx-font-size: 14px; -fx-padding: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 1);"/>
                <TextFlow style="-fx-padding: 5 0 0 0;">
                    <Text text="Enter 키를 눌러 구절 추가" style="-fx-fill: #6C757D; -fx-font-size: 12;"/>
                </TextFlow>
            </VBox>

            <!-- Selected Verses Management Panel -->
            <Label text="선택된 구절" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #212529;"/>
            <ScrollPane prefHeight="250" fitToWidth="true"
                      style="-fx-background-color: white; -fx-border-color: #CED4DA; -fx-border-radius: 8; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 4, 0, 0, 1);">
                <content>
                    <VBox fx:id="verseManagementList" spacing="8" style="-fx-padding: 10;">
                        <!-- Verse items will be added here dynamically -->
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Action Buttons -->
            <HBox spacing="10">
                <!-- Clear Button -->
                <Button text="지우기" onAction="#onClearButtonClick"
                        style="-fx-background-color: #E9ECEF; -fx-text-fill: #495057; -fx-font-weight: bold;
                               -fx-background-radius: 6; -fx-padding: 10 15; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 4, 0, 0, 1);"
                        prefWidth="100"/>

                <!-- Generate Button -->
                <Button text="PPT 만들기" onAction="#onGeneratePPTButtonClick"
                        style="-fx-background-color: #4361EE; -fx-text-fill: white; -fx-font-weight: bold;
                               -fx-background-radius: 6; -fx-padding: 10 15; -fx-cursor: hand;
                               -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 4, 0, 0, 1);"
                        prefWidth="200"/>
            </HBox>
        </VBox>
    </left>

    <!-- Center Panel - Preview Area -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20; -fx-background-color: white;">
            <Label text="슬라이드 프리뷰" style="-fx-font-weight: bold; -fx-font-size: 20; -fx-text-fill: #212529;"/>

            <!-- Preview Card -->
            <StackPane fx:id="previewPane" prefHeight="400" prefWidth="500" maxWidth="600"
                       style="-fx-background-color: white; -fx-border-color: #CED4DA;
                              -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;
                              -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 3);">
                <Label fx:id="previewLabel" text="선택된 구절 없음"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-alignment: center; -fx-text-fill: #6C757D;"/>
            </StackPane>

            <TextFlow textAlignment="CENTER" maxWidth="500">
                <Text text="미리보기는 실제 PPT와 다를 수 있습니다. 구절을 추가하면 미리보기가 업데이트됩니다." 
                      style="-fx-fill: #6C757D; -fx-font-size: 14;"/>
            </TextFlow>
        </VBox>
    </center>

    <!-- Right Panel - Advertisement -->
    <right>
        <VBox spacing="10.0" prefWidth="380" style="-fx-background-color: #F8F9FA; -fx-padding: 20;">
            <Label text="광고" style="-fx-font-weight: bold; -fx-font-size: 16; -fx-text-fill: #212529;"/>

            <!-- Ad Container -->
            <VBox style="-fx-background-color: white; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 3); -fx-padding: 10;">
                <!-- Ad WebView -->
                <WebView fx:id="adWebView" prefHeight="750" prefWidth="360" />
            </VBox>
        </VBox>
    </right>

    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0"/>
    </padding>
</BorderPane>
