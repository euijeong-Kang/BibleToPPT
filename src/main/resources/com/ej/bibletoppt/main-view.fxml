<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.web.WebView?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.ej.bibletoppt.controller.BibleToPPTController"
            style="-fx-background-color: linear-gradient(from 0% 0% to 100% 100%, #FDFDFE, #FFFFFF); -fx-opacity: 0.96;">

    <!-- Left Panel - Bible Verse Input & History -->
    <left>
        <VBox spacing="10.0" prefWidth="300" style="-fx-background-color: #F3F0FA; -fx-padding: 15;">
            <Label text="성경구절 입력" style="-fx-font-weight: bold; -fx-font-size: 16;"/>

            <!-- Settings Panel -->
            <VBox spacing="10.0" style="-fx-background-color: #EFEAFA; -fx-padding: 10; -fx-background-radius: 8;">
                <HBox spacing="10.0">
                    <Label text="사이즈:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="sizeComboBox" promptText="크기 선택" styleClass="form-control"/>
                </HBox>

                <HBox spacing="10.0">
                    <Label text="글꼴:" style="-fx-font-weight: bold;"/>
                    <ComboBox fx:id="fontComboBox" promptText="글꼴 선택" styleClass="form-control"/>
                </HBox>

                <CheckBox fx:id="titleSlideCheckBox" text="제목 슬라이드 추가"
                          style="-fx-text-fill: #333333;"/>
            </VBox>

            <!-- Bible Verse Input -->
            <Label text="성경구절 입력" style="-fx-font-weight: bold; -fx-padding: 5 0 0 0;"/>
            <VBox>
                <TextField fx:id="inputField" promptText="성경구절 입력 (예: 창 1:1)"
                           style="-fx-background-color: white; -fx-border-color: #E6DFFA; -fx-border-radius: 4; -fx-font-size: 16px; -fx-padding: 8;"/>
            </VBox>

            <!-- Selected Verses Management Panel -->
            <Label text="선택된 구절" style="-fx-font-weight: bold; -fx-padding: 10 0 0 0;"/>
            <ScrollPane prefHeight="250" fitToWidth="true"
                      style="-fx-background-color: white; -fx-border-color: #E6DFFA; -fx-border-radius: 4;">
                <content>
                    <VBox fx:id="verseManagementList" spacing="5" style="-fx-padding: 5;">
                        <!-- Verse items will be added here dynamically -->
                    </VBox>
                </content>
            </ScrollPane>

            <!-- Generate Button -->
            <Button text="PPT 만들기" onAction="#onGeneratePPTButtonClick"
                    style="-fx-background-color: #E6DFFA; -fx-text-fill: #333333; -fx-font-weight: bold;
                           -fx-background-radius: 4; -fx-padding: 10 20; -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 3, 0, 0, 1);"
                    prefWidth="280"/>
        </VBox>
    </left>

    <!-- Center Panel - Preview Area -->
    <center>
        <VBox alignment="CENTER" spacing="20" style="-fx-padding: 20;">
            <Label text="슬라이드 프리뷰" style="-fx-font-weight: bold; -fx-font-size: 16;"/>

            <!-- Preview Card -->
            <StackPane fx:id="previewPane" prefHeight="300" prefWidth="400"
                       style="-fx-background-color: white; -fx-border-color: #E6DFFA;
                              -fx-border-radius: 12; -fx-background-radius: 12; -fx-padding: 20;">
                <Label fx:id="previewLabel" text="선택된 구절 없음"
                       style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-alignment: center;"/>
            </StackPane>

            <!-- Clear Button -->
            <Button text="지우기" onAction="#onClearButtonClick"
                    style="-fx-background-color: #eee8fa; -fx-text-fill: #333333; -fx-font-weight: bold;
                           -fx-background-radius: 4; -fx-padding: 8 16; -fx-cursor: hand;
                           -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.05), 3, 0, 0, 1);"/>
        </VBox>
    </center>

    <!-- Right Panel - Advertisement -->
    <right>
        <VBox spacing="5.0" prefWidth="380" style="-fx-background-color: #F6F3FB; -fx-padding: 15;">

            <!-- Ad WebView -->
            <WebView fx:id="adWebView" prefHeight="830" prefWidth="380" />
        </VBox>
    </right>

    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
    </padding>
</BorderPane>
